# SOCMind AI environment template.
#
# Copy to backend/.env (the backend reads ".env" from the directory it is started in) and edit.
# Every variable below is optional: the defaults work for local development.
# NEVER put real API keys or secrets in this file or commit a real .env.
# Only variables the code actually reads are listed here.

# --- General ---------------------------------------------------------------
PROJECT_NAME="SOCMind AI"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# --- Database --------------------------------------------------------------
# SQLite file, relative to the directory the backend is started in. Tables and the incidents.details
# column are created/added automatically at startup; existing rows are never touched.
DATABASE_URL="sqlite:///./socmind.db"
# Any SQLAlchemy URL works for the models, but only SQLite has been tested in this project.

# --- CORS (JSON list of origins allowed to call the API from a browser) ---------
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# --- Threat intelligence ---------------------------------------------------------
# true  = look IOCs up in the built-in LOCAL MOCK dataset (results are labelled mock and unverified)
# false = extract IOCs but perform NO lookups (every reputation is UNKNOWN = "not checked")
# There is no live provider (VirusTotal, AbuseIPDB, ...); none is implemented, so no API keys are read.
THREAT_INTEL_MOCK_MODE=True

# --- Not used ----------------------------------------------------------------
# LLM_PROVIDER / LLM_MODEL_NAME / LLM_API_KEY exist in the settings but no agent reads them: all five agents are
# deterministic rules and no LLM is called. There is no authentication, so no JWT secret is read either.

# --- Frontend (set in frontend/.env.local, NOT here; Vite bundles VITE_* values into the page) ----------------
# VITE_API_BASE=http://localhost:8000/api/v1
