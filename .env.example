# SOCMind AI environment template.
#
# Copy to backend/.env (the backend reads ".env" from the directory it is started in) and edit.
# Every variable below is optional: the defaults work for local development.
# NEVER put real API keys or secrets in this file or commit a real .env.
# Only variables the code actually reads are listed here.

# --- General ---------------------------------------------------------------
PROJECT_NAME="SOCMind AI"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# --- Database --------------------------------------------------------------
# SQLite file, relative to the directory the backend is started in. Tables and the incidents.details
# column are created/added automatically at startup; existing rows are never touched.
DATABASE_URL="sqlite:///./socmind.db"
# Any SQLAlchemy URL works for the models, but only SQLite has been tested in this project.

# --- CORS (JSON list of origins allowed to call the API from a browser) ---------
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# --- Threat intelligence ---------------------------------------------------------
# THREAT_INTEL_MOCK_MODE=false switches ALL lookups off: IOCs are extracted but never looked up (reputation UNKNOWN
# means "not checked"). It overrides everything below.
THREAT_INTEL_MOCK_MODE=True

# Which source answers lookups:
#   mock        (default) offline, built-in sample dataset. Results are labelled mock and unverified.
#   virustotal  LIVE lookups on VirusTotal's public API. Opt-in: needs VIRUSTOTAL_API_KEY. Without a key the app falls
#               back to the labelled mock provider and says so (Settings page, GET /api/v1/config, enrichment result).
THREAT_INTEL_PROVIDER="mock"

# --- VirusTotal (only used when THREAT_INTEL_PROVIDER=virustotal) -------------------------------------------------
# Put your key in backend/.env or the process environment ONLY. It is never logged, never returned by the API and never
# stored in the database. The public API is for non-commercial use and allows 4 requests/minute and 500/day.
# Indicators sent to VirusTotal leave your network: public IPs, domains and file hashes only. Private/reserved IPs and
# URLs are never sent.
# VIRUSTOTAL_API_KEY=
# VIRUSTOTAL_MALICIOUS_THRESHOLD=3        # engines that must flag an indicator before it is rated MALICIOUS
# VIRUSTOTAL_MAX_LOOKUPS_PER_ALERT=5      # network requests spent on one alert; the rest wait for a later run
# VIRUSTOTAL_REQUESTS_PER_MINUTE=4
# VIRUSTOTAL_REQUESTS_PER_DAY=500
# VIRUSTOTAL_TIMEOUT_SECONDS=10
# VIRUSTOTAL_CACHE_TTL_SECONDS=86400      # in-memory cache of completed lookups (lost on restart)

# --- Not used ----------------------------------------------------------------
# LLM_PROVIDER / LLM_MODEL_NAME / LLM_API_KEY exist in the settings but no agent reads them: all five agents are
# deterministic rules and no LLM is called. There is no authentication, so no JWT secret is read either.
# No other threat-intelligence provider (AbuseIPDB, ...) is implemented.

# --- Frontend (set in frontend/.env.local, NOT here; Vite bundles VITE_* values into the page) ----------------
# VITE_API_BASE=http://localhost:8000/api/v1

