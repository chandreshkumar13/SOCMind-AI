# SOCMind AI Environment Variables Template
# NEVER place actual API keys or secrets in repository!

# General App Config
PROJECT_NAME="SOCMind AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Port Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database Settings (SQLite default for simple local dev, PostgreSQL for docker)
DATABASE_URL="sqlite:///./socmind.db"
# DATABASE_URL="postgresql://socmind_user:socmind_password@localhost:5432/socmind_db"

# LLM / AI Configuration (Placeholders for configurable model provider)
LLM_PROVIDER="mock" # Options: mock, openai, gemini, ollama
LLM_MODEL_NAME="gemini-2.5-flash-mock"
LLM_API_KEY="YOUR_API_KEY_PLACEHOLDER"

# Threat Intelligence Tool Integrations (Mocks enabled by default)
THREAT_INTEL_MOCK_MODE=True
VIRUSTOTAL_API_KEY="YOUR_VIRUSTOTAL_KEY_PLACEHOLDER"
ABUSEIPDB_API_KEY="YOUR_ABUSEIPDB_KEY_PLACEHOLDER"

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
JWT_SECRET_KEY="development_jwt_secret_key_change_in_production"
